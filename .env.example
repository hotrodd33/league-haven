# Pooled Neon connection string from the Neon console (hostname contains "-pooler").
# A direct host keeps a session open and stops compute from suspending.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require

# Optional. Leave unset. Stale live-scoring claims are cleared when someone
# opens a game. Setting this true does not schedule anything by itself; a
# frequent caller of /api/games/sweep will keep Neon compute awake.
# ENABLE_SCORER_SWEEP_CRON=true

# Generate a random string for JWT signing
JWT_SECRET=change-me-to-a-random-string

# Only for local dev (Vercel sets its own port)
PORT=3001

# Email service (SendGrid) - required for registration emails, password resets, invites
# Get your API key at https://sendgrid.com
SENDGRID_API_KEY=your-sendgrid-api-key-here

# From address for outgoing emails (must be verified in Resend)
FROM_EMAIL=LeagueHaven <noreply@leaguehaven.com>

# Public URL of the app (used in email links)
APP_URL=https://leaguehaven.com

# Push Notifications (VAPID keys) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Discord webhook for bug reports — create at: Discord channel → Edit → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# Get this from Neon console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Generate a random string for JWT signing
JWT_SECRET=change-me-to-a-random-string

# Only for local dev (Vercel sets its own port)
PORT=3001

# Email service (SendGrid) - required for registration emails, password resets, invites
# Get your API key at https://sendgrid.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# From address for outgoing emails (must be verified in Resend)
FROM_EMAIL=ZVBL <noreply@zvbl.org>

# Public URL of the app (used in email links)
APP_URL=https://portal.zvbl.org
